# NV-Segment-CT (VISTA-3D) INFERENCE image for SageMaker ASYNC endpoints.
#
# DEDICATED inference image (Tier 3 per the import-monai-bundle skill): the
# bundle needs MONAI 1.4 on PyTorch 2.4 — the shared sm-monai-bundle-inference
# (torch 2.6 / MONAI 1.3) cannot serve it. Based on the PyTorch 2.4 (cu124)
# INFERENCE DLC, which provides serve/nginx/gunicorn and the /ping +
# /invocations contract. Deployment is async-only (3D volumetric inference).
#
# The handler (src/nvmedtech/inference.py) drives VISTA's own inference.json
# via `monai.bundle run` with a single-image input_dict + optional prompts,
# preferring models/model_finetune.pt when the artifact carries one.
#
# Per the proven pattern, the handler is baked here AND shipped in the artifact
# at code/inference.py (src/nvmedtech/package.py injects it — the DLC discovers
# handlers at /opt/ml/model/code/). Dependencies are baked in this image, so
# the artifact carries NO code/requirements.txt -> fast cold start.
#
# Build: bash build_and_push_nvmedtech_inference.sh   (BuildKit off -> V2 manifest)

FROM --platform=linux/amd64 763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.4.0-gpu-py311-cu124-ubuntu22.04-sagemaker

# ── VISTA-3D runtime dependencies (MONAI 1.4 stack; cucim excluded) ──────────
COPY src/nvmedtech/requirements.txt /tmp/requirements-nvmedtech-inference.txt
RUN pip install --no-cache-dir -r /tmp/requirements-nvmedtech-inference.txt

# ── Handler baked at /opt/program (discovered via SAGEMAKER_PROGRAM) ─────────
COPY src/nvmedtech/inference.py /opt/program/inference.py

ENV SAGEMAKER_PROGRAM inference.py
ENV SAGEMAKER_SUBMIT_DIRECTORY /opt/program

# NOTE: SageMaker inference containers require root for nginx/gunicorn/MMS.
# HEALTHCHECK is managed by SageMaker via its /ping route.
