# Private environment overrides (gitignored — safe for real credentials)
# Copy this to .env.local and fill in your values

# Your AWS account ID (used for ECR image URIs)
AWS_ACCOUNT_ID=your-12-digit-account-id

# SageMaker execution role
SAGEMAKER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/your-sagemaker-role

# MLflow tracking server name (used to scope IAM permissions)
# Replace with your tracking server name from SageMaker
MLFLOW_TRACKING_SERVER_NAME=your-tracking-server-name

# Test data locations
TEST_IMAGE_S3_URI=s3://your-bucket/path/to/test/image.dcm
TEST_SEGMENTATION_S3_URI=s3://your-bucket/path/to/test/volume.nii.gz

# ECR image URIs (built via build_and_push.sh)
TRAINING_IMAGE_CLASSIFICATION=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/sm-training-byoc-classification:latest
TRAINING_IMAGE_SEGMENTATION=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/sm-training-byoc-segmentation:latest
INFERENCE_IMAGE_CLASSIFICATION=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/sm-inference-byoc-classification:latest
INFERENCE_IMAGE_SEGMENTATION=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/sm-inference-byoc-segmentation:latest
