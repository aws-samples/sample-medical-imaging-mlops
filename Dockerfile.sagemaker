# Build args:
#   TASK=classification (default) | segmentation
ARG TASK=classification

FROM 763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.9.0-gpu-py312-cu130-ubuntu22.04-sagemaker
ARG TASK
COPY src/${TASK}/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY src/${TASK}/ /opt/program/

# Copy inference code alongside train.py so it's always found at the same level,
# even when SageMaker relocates scripts to /opt/ml/code/ at runtime
COPY src/inference/${TASK}/inference.py /opt/program/inference.py
COPY src/inference/${TASK}/requirements.txt /opt/program/requirements-inference.txt

ENV SAGEMAKER_PROGRAM train.py

# NOTE: SageMaker training containers require root to write to /opt/ml and
# interact with the SageMaker training toolkit. A non-root USER is not added here.

# NOTE: HEALTHCHECK is not applicable — SageMaker manages container lifecycle
# and health via its own orchestration layer.
