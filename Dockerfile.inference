# Inference image for SageMaker real-time / async endpoints.
# Based on the AWS PyTorch inference DLC which provides the 'serve' entrypoint,
# nginx, gunicorn, and the multi-model server — required for SageMaker endpoints.
#
# Build args:
#   TASK=classification (default) | segmentation
#
# Usage:
#   ./build_and_push_inference.sh [classification|segmentation]

ARG TASK=classification

FROM 763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.6.0-gpu-py312-cu124-ubuntu22.04-sagemaker

ARG TASK

COPY src/inference/${TASK}/requirements.txt /tmp/requirements-inference.txt
RUN pip install --no-cache-dir -r /tmp/requirements-inference.txt

# Copy inference code (uniform structure: src/inference/${TASK}/ always has inference.py)
COPY src/inference/${TASK}/ /opt/program/

ENV SAGEMAKER_PROGRAM inference.py
ENV SAGEMAKER_SUBMIT_DIRECTORY /opt/program

# NOTE: SageMaker inference containers require root for nginx, gunicorn, and the
# multi-model server. A non-root USER is not added here.

# NOTE: HEALTHCHECK is not applicable — SageMaker manages endpoint health via
# its own /ping route and orchestration layer.
